# Konfigurasi Opsional SMTP untuk Pengiriman Kode OTP Email Asli (Nodemailer)
# Jika tidak diisi, aplikasi tetap berjalan normal dan menampilkan Kode OTP
# secara instan melalui Toast Notification di layar (Siap Demo Hackathon!).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-digit-gmail-app-password
SMTP_FROM="JejakLangsa Tourism <no-reply@jejaklangsa.id>"

